# ============================================================
# XAUUSD Dashboard — Backend Environment Variables Template
# ============================================================
# Copy file này thành backend/.env và điền giá trị thực vào.
# KHÔNG bao giờ commit file .env thật lên GitHub!
#
#   cp backend/.env.example backend/.env
# ============================================================

# ── Finnhub API (giá XAUUSD/XAGUSD real-time) ──────────────
# Đăng ký miễn phí tại: https://finnhub.io/register
FINNHUB_TOKEN=your_finnhub_api_token_here

# Optional direct OANDA v20 market data (XAU_USD spot).
# Leave blank to keep Finnhub OANDA spot realtime plus MongoDB candle history.
OANDA_ENVIRONMENT=practice
OANDA_ACCOUNT_ID=your_oanda_v20_account_id
OANDA_API_TOKEN=your_oanda_v20_api_token

# ── MongoDB Atlas (users and XAUUSD candle history) ─────────
# Lấy từ: MongoDB Atlas → Connect → Drivers → Copy URI
# Thay <password> bằng mật khẩu thật, <dbname> bằng tên database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── JWT Secret (bảo vệ phiên đăng nhập) ─────────────────────
# Tạo chuỗi ngẫu nhiên 64 ký tự:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_random_64_char_secret_here

# Used only when backend/users.json does not exist. Existing accounts are not changed.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# ── Webhook Secret (xác thực TradingView alerts) ─────────────
# Đặt một chuỗi bí mật bất kỳ, dùng cùng chuỗi trong TradingView webhook message
WEBHOOK_SECRET=your_webhook_secret_here

# ── MetaApi Token (kết nối MT5) ─────────────────────────────
# Đăng ký tại: https://metaapi.cloud → API Tokens
METAAPI_TOKEN=your_metaapi_token_here

# ── Encryption Key (mã hóa dữ liệu nhạy cảm) ────────────────
# Chuỗi 32 ký tự bất kỳ: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=your_32_char_encryption_key_here

# ── Server Port ──────────────────────────────────────────────
PORT=5000

# ── TCP Port (MT5 EA connection) ────────────────────────────
TCP_PORT=7788

# ── CORS Origins (nếu cần whitelist domain cụ thể) ──────────
# Để trống = chấp nhận tất cả origins
# ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
