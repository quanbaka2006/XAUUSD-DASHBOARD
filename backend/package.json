{
  "name": "xauusd-dashboard-backend",
  "version": "1.0.0",
  "description": "Backend for XAUUSD Real-time Trading Dashboard",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --ignore vps_slots/ server.js",
    "test": "node --test test/*.test.js",
    "probe:xauusd:finnhub": "node scripts/probe-xauusd-oanda.js --provider=finnhub --count=500",
    "probe:xauusd:oanda": "node scripts/probe-xauusd-oanda.js --provider=oanda --count=500"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "express-slow-down": "^3.1.0",
    "helmet": "^8.2.0",
    "hpp": "^0.2.3",
    "metaapi.cloud-sdk": "^29.3.3",
    "mongodb": "^6.21.0",
    "node-telegram-bot-api": "^0.66.0",
    "socket.io": "^4.7.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
