NODE_ENV=production
PORT=5100

# Dedicated MongoDB database user. Do not reuse the AlphaGold database account.
SCREENCLONE_MONGODB_URI=mongodb+srv://screenclone_user:change-me@cluster.example/screenclone_license
SCREENCLONE_DB_NAME=screenclone_license

# Generated by scripts/generateScreenCloneLicenseKey.js
SCREENCLONE_LICENSE_PRIVATE_KEY_B64=
SCREENCLONE_TOKEN_PEPPER=

# Generated by scripts/generateAdminCredentials.js
SCREENCLONE_ADMIN_USERNAME=owner
SCREENCLONE_ADMIN_PASSWORD_HASH=
SCREENCLONE_ADMIN_SESSION_SECRET=

SCREENCLONE_MIN_CLIENT_VERSION=1.1.0
SCREENCLONE_OFFLINE_HOURS=12
SCREENCLONE_ALLOWED_HOSTS=license.alphagoldhub.com
